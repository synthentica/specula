            "size": 1359,
            "mimeType": "application/json",
            "text": "{\"posts\":[{\"id\":\"6acbc9a4b2f88b00015b31bc\",\"title\":\"Weekend hike in the hills\",\"visibility\":\"public\",\"published_at\":\"2026-10-11T17:39:07.000Z\",\"mobiledoc\":null,\"lexical\":\"{\\\"root\\\":{\\\"children\\\":[{\\\"children\\\":[{\\\"detail\\\":0,\\\"format\\\":0,\\\"mode\\\":\\\"normal\\\",\\\"style\\\":\\\"\\\",\\\"text\\\":\\\"We left early and reached the ridge before noon. The view was worth every step.\\\",\\\"type\\\":\\\"extended-text\\\",\\\"version\\\":1}],\\\"direction\\\":\\\"ltr\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"type\\\":\\\"paragraph\\\",\\\"version\\\":1}],\\\"direction\\\":\\\"ltr\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"type\\\":\\\"root\\\",\\\"version\\\":1}}\",\"url\":\"http://localhost:2368/weekend-hike-in-the-hills/\"},{\"id\":\"6acbc96bb2f88b00015b2f7d\",\"title\":\"Coming soon\",\"visibility\":\"public\",\"published_at\":\"2026-10-11T17:37:47.000Z\",\"mobiledoc\":\"{\\\"version\\\":\\\"0.3.1\\\",\\\"atoms\\\":[],\\\"cards\\\":[],\\\"markups\\\":[[\\\"a\\\",[\\\"href\\\",\\\"#/portal/\\\"]]],\\\"sections\\\":[[1,\\\"p\\\",[[0,[],0,\\\"This is Field notes, a brand new site by <redacted:pii> that's just getting started. Things will be up and running here shortly, but you can \\\"],[0,[0],1,\\\"subscribe\\\"],[0,[],0,\\\" in the meantime if you'd like to stay up to date and receive emails when new content is published!\\\"]]]],\\\"ghostVersion\\\":\\\"4.0\\\"}\",\"lexical\":null,\"url\":\"http://localhost:2368/coming-soon/\"}],\"meta\":{\"pagination\":{\"page\":1,\"limit\":5,\"pages\":1,\"total\":2,\"next\":null,\"prev\":null}}}"
