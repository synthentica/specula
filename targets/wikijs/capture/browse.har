ensions.title\",\"value\":\"Extensions\",\"__typename\":\"Translation\"},{\"key\":\"general.companyName\",\"value\":\"Company / Organization Name\",\"__typename\":\"Translation\"},{\"key\":\"general.companyNameHint\",\"value\":\"Name to use when displaying copyright notice in the footer. Leave empty to hide.\",\"__typename\":\"Translation\"},{\"key\":\"general.contentLicense\",\"value\":\"Content License\",\"__typename\":\"Translation\"},{\"key\":\"general.contentLicenseHint\",\"value\":\"License shown in the footer of all content pages.\",\"__typename\":\"Translation\"},{\"key\":\"general.displayEditMenuBar\",\"value\":\"Display Edit Menu Bar\",\"__typename\":\"Translation\"},{\"key\":\"general.displayEditMenuBarHint\",\"value\":\"Display the edit menu bar in the page header.\",\"__typename\":\"Translation\"},{\"key\":\"general.displayEditMenuBtn\",\"value\":\"Display Edit Button\",\"__typename\":\"Translation\"},{\"key\":\"general.displayEditMenuBtnHint\",\"value\":\"Display a button to edit the current page.\",\"__typename\":\"Translation\"},{\"key\":\"general.displayEditMenuExternalBtn\",\"value\":\"Display External Edit Button\",\"__typename\":\"Translation\"},{\"key\":\"general.displayEditMenuExternalBtnHint\",\"value\":\"Display a button linking to an external repository (e.g. GitHub) where users can edit or submit a PR for the current page.\",\"__typename\":\"Translation\"},{\"key\":\"general.editFab\",\"value\":\"FAB Quick Edit Menu\",\"__typename\":\"Translation\"},{\"key\":\"general.editFabHint\",\"value\":\"Display the edit floating action button (FAB) with a speed-dial menu in the bottom right corner of the screen.\",\"__typename\":\"Translation\"},{\"key\":\"general.editMenuBar\",\"value\":\"Edit Menu Bar\",\"__typename\":\"Translation\"},{\"key\":\"general.editMenuExternalIcon\",\"value\":\"Button Icon\",\"__typename\":\"Translation\"},{\"key\":\"general.editMenuExternalIconHint\",\"value\":\"The icon to display on the edit button. For example, mdi-gi