nsions\",\"__typename\":\"Translation\"},{\"key\":\"general.pageExtensionsHint\",\"value\":\"A comma-separated list of URL extensions that will be treated as pages. For example, adding md will treat /foobar.md the same as /foobar.\",\"__typename\":\"Translation\"},{\"key\":\"general.saveSuccess\",\"value\":\"Site configuration saved successfully.\",\"__typename\":\"Translation\"},{\"key\":\"general.siteBranding\",\"value\":\"Site Branding\",\"__typename\":\"Translation\"},{\"key\":\"general.siteDescription\",\"value\":\"Site Description\",\"__typename\":\"Translation\"},{\"key\":\"general.siteDescriptionHint\",\"value\":\"Default description when none is provided for a page.\",\"__typename\":\"Translation\"},{\"key\":\"general.siteInfo\",\"value\":\"Site Info\",\"__typename\":\"Translation\"},{\"key\":\"general.siteTitle\",\"value\":\"Site Title\",\"__typename\":\"Translation\"},{\"key\":\"general.siteTitleHint\",\"value\":\"Displayed in the top bar and appended to all pages meta title.\",\"__typename\":\"Translation\"},{\"key\":\"general.siteTitleInvalidChars\",\"value\":\"Site Title contains invalid characters.\",\"__typename\":\"Translation\"},{\"key\":\"general.siteUrl\",\"value\":\"Site URL\",\"__typename\":\"Translation\"},{\"key\":\"general.siteUrlHint\",\"value\":\"Full URL to your wiki, without the trailing slash. (e.g. https://wiki.example.com)\",\"__typename\":\"Translation\"},{\"key\":\"general.subtitle\",\"value\":\"Main settings of your wiki\",\"__typename\":\"Translation\"},{\"key\":\"general.title\",\"value\":\"General\",\"__typename\":\"Translation\"},{\"key\":\"general.uploadClear\",\"value\":\"Clear\",\"__typename\":\"Translation\"},{\"key\":\"general.uploadLogo\",\"value\":\"Upload Logo\",\"__typename\":\"Translation\"},{\"key\":\"general.uploadSizeHint\",\"value\":\"An image of {{size}} pixels is recommended for best results.\",\"__typename\":\"Translation\"},{\"key\":\"general.uploadTypesHint\",\"value\":\"{{typeList}} or {{lastType}} files only\",\"__typename\":\"Translation\"},{\"key\":\"groups.title\",\"value\":\"Groups\",\"__typename\":\"Translation\"},{\"key\":\"locale.activeNamespaces.hint\",\"value\":\"List of locales enabled for multilingual namespacing. The base locale defined above will always be included regardless of this selection.\",\"__typename\":\"Translation\"},{\"key\":\"locale.activeNamespaces.label\",\"value\":\"Active Namespaces\",\"__typename\":\"Translation\"},{\"key\":\"locale.autoUpdate.hint\",\"value\":\"Automatically download updates to this locale as they become available.\",\"__typename\":\"Translation\"},{\"key\":\"locale.autoUpdate.hintWithNS\",\"value\":\"Automatically download updates to all namespaced locales enabled below.\",\"__typename\":\"Translation\"},{\"key\":\"locale.autoUpdate.label\",\"value\":\"Update Automatically\",\"__typename\":\"Translation\"},{\"key\":\"locale.availability\",\"value\":\"Availability\",\"__typename\":\"Translation\"},{\"key\":\"locale.base.hint\",\"value\":\"All UI text elements will be displayed in selected language.\",\"__typename\":\"Translation\"},{\"key\":\"locale.base.label\",\"value\":\"Site Locale\",\"__typename\":\"Translation\"},{\"key\":\"locale.base.labelWithNS\",\"value\":\"Base Locale\",\"__typename\":\"Translation\"},{\"key\":\"locale.code\",\"value\":\"Code\",\"__typename\":\"Translation\"},{\"key\":\"locale.download\",\"value\":\"Download\",\"__typename\":\"Translation\"},{\"key\":\"locale.downloadTitle\",\"value\":\"Download Locale\",\"__typename\":\"Translation\"},{\"key\":\"locale.name\",\"value\":\"Name\",\"__typename\":\"Translation\"},{\"key\":\"locale.namespaces.hint\",\"value\":\"Enables multiple language versions of the same page.\",\"__typename\":\"Translation\"},{\"key\":\"locale.namespaces.label\",\"value\":\"Multilingual Namespaces\",\"__typename\":\"Translation\"},{\"key\":\"locale.namespacing\",\"value\":\"Multilingual Namespacing\",\"__typename\":\"Translation\"},{\"key\":\"locale.namespacingPrefixWarning.s