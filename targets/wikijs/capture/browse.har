e\":\"Make a donation\",\"__typename\":\"Translation\"},{\"key\":\"contribute.needYourHelp\",\"value\":\"We need your help to keep improving the software and run the various associated services (e.g. hosting and networking).\",\"__typename\":\"Translation\"},{\"key\":\"contribute.openCollective\",\"value\":\"Wiki.js is also part of the Open Collective initiative, a transparent fund that goes toward community resources. You can contribute financially by making a monthly or one-time donation:\",\"__typename\":\"Translation\"},{\"key\":\"contribute.openSource\",\"value\":\"Wiki.js is a free and open-source software brought to you with {{0}} by {{1}} and {{2}}.\",\"__typename\":\"Translation\"},{\"key\":\"contribute.openSourceContributors\",\"value\":\"contributors\",\"__typename\":\"Translation\"},{\"key\":\"contribute.patreon\",\"value\":\"Become a backer or sponsor via Patreon (goes directly into supporting lead developer Nicolas Giard's goal of working full-time on Wiki.js)\",\"__typename\":\"Translation\"},{\"key\":\"contribute.paypal\",\"value\":\"Make a one-time or recurring donation via Paypal:\",\"__typename\":\"Translation\"},{\"key\":\"contribute.shop\",\"value\":\"Wiki.js Shop\",\"__typename\":\"Translation\"},{\"key\":\"contribute.spreadTheWord\",\"value\":\"Spread the word\",\"__typename\":\"Translation\"},{\"key\":\"contribute.submitAnIdea\",\"value\":\"Submit an idea or vote on a proposed one on the {{0}}.\",\"__typename\":\"Translation\"},{\"key\":\"contribute.submitAnIdeaLink\",\"value\":\"feature requests board\",\"__typename\":\"Translation\"},{\"key\":\"contribute.subtitle\",\"value\":\"Help support Wiki.js development and operations\",\"__typename\":\"Translation\"},{\"key\":\"contribute.talkToFriends\",\"value\":\"Talk to your friends and colleagues about how awesome Wiki.js is!\",\"__typename\":\"Translation\"},{\"key\":\"contribute.title\",\"value\":\"Contribute to Wiki.js\",\"__typename\":\"Translation\"},{\"key\":\"contribute.tshirts\",\"value